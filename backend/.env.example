# --- Server ---
ENVIRONMENT=development
PORT=3001
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Prices and Kiwi `curr` param. Use USD to match the current frontend labels,
# or INR if you later switch the UI to rupees (budget parser still accepts ₹ / lakh).
APP_CURRENCY=USD

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Optional. Only needed for POST /api/trips/{id}/save with a user JWT.
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Kiwi Tequila ---
KIWI_API_KEY=YOUR_KIWI_API_KEY
KIWI_API_BASE=https://api.tequila.kiwi.com
# Set true to skip live Kiwi calls (Tequila is partner-only). Claude + DB still run for real.
KIWI_MOCK=false

# --- Redis (Upstash redis URL, e.g. rediss://default:TOKEN@HOST:6379) ---
# Optional in development — in-memory cache is used if omitted.
# Required when ENVIRONMENT=production.
REDIS_URL=
